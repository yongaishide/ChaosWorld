[General]
	#是否允许玩家自定义【物品管道】的抽取频率（1~200 tick）。
	enableItemCustomFrequency = true
	#是否允许玩家自定义【流体管道】的抽取频率（1~200 tick）。
	enableFluidCustomFrequency = true
	#是否允许玩家自定义【能量管道】的抽取频率（1~200 tick）。
	enableEnergyCustomFrequency = true
	#是否允许玩家自定义【气体管道】的抽取频率（1~200 tick）。
	enableGasCustomFrequency = true

[Optimization]
	#物品管道在空/满时的最大休眠时间（tick）。
	# Default: 40
	# Range: 1 ~ 1200
	itemMaxSleep = 40
	#流体管道在空/满时的最大休眠时间（tick）。
	# Default: 40
	# Range: 1 ~ 1200
	fluidMaxSleep = 40
	#能量管道在空/满时的最大休眠时间（tick）。（建议保持较低以防断电）
	# Default: 5
	# Range: 1 ~ 1200
	energyMaxSleep = 5
	#气体管道在空/满时的最大休眠时间（tick）。
	# Default: 40
	# Range: 1 ~ 1200
	gasMaxSleep = 40

	[Upgrades.Item]
		#ATM升级的传输速率
		# Default: 4096
		# Range: > 1
		itemRateAtm = 4096
		#振金升级的传输速率
		# Default: 65536
		# Range: > 1
		itemRateVibranium = 65536
		#难得素升级的传输速率
		# Default: 1048576
		# Range: > 1
		itemRateUnobtainium = 1048576
		#恒星合金升级的传输速率
		# Default: 16777216
		# Range: > 1
		itemRateStellar = 16777216

	[Upgrades.Fluid]
		#ATM升级的传输速率
		# Default: 1000000
		# Range: > 1
		fluidRateAtm = 1000000
		#振金升级的传输速率
		# Default: 16000000
		# Range: > 1
		fluidRateVibranium = 16000000
		#难得素升级的传输速率
		# Default: 256000000
		# Range: > 1
		fluidRateUnobtainium = 256000000
		#恒星合金升级的传输速率
		# Default: 1000000000
		# Range: > 1
		fluidRateStellar = 1000000000

	[Upgrades.Energy]
		#ATM升级的传输速率
		# Default: 10000000
		# Range: > 1
		energyRateAtm = 10000000
		#振金升级的传输速率
		# Default: 100000000
		# Range: > 1
		energyRateVibranium = 100000000
		#难得素升级的传输速率
		# Default: 500000000
		# Range: > 1
		energyRateUnobtainium = 500000000
		#恒星合金升级的传输速率
		# Default: 1500000000
		# Range: > 1
		energyRateStellar = 1500000000

	[Upgrades.Gas]
		#ATM升级的传输速率
		# Default: 4000000
		# Range: > 1
		gasRateAtm = 4000000
		#振金升级的传输速率
		# Default: 64000000
		# Range: > 1
		gasRateVibranium = 64000000
		#难得素升级的传输速率
		# Default: 512000000
		# Range: > 1
		gasRateUnobtainium = 512000000
		#恒星合金升级的传输速率
		# Default: 1500000000
		# Range: > 1
		gasRateStellar = 1500000000
