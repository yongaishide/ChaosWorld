#启用万象创世蜜蜂
#false时禁用蜜蜂相关功能，仅保留通用机械资源蜜蜂机器
myriadCreationsEnabled = true

#万象创世蜜蜂过滤配置（存档级别）
[myriad_creations_filter]
	#过滤模式
	#DISABLED/BLOCKLIST/WHITELIST
	#Allowed Values: DISABLED, BLACKLIST, WHITELIST
	filterMode = "DISABLED"
	#过滤的蜜蜂类型列表
	#格式: modID:beeType
	filteredBeeTypes = []

#万象创世蜜蜂属性覆盖配置（服务端生效）
[bee_attributes]
	#授粉物品ID
	flowerItem = "productivebees:honey_treat"
	#是否能产出蜜脾
	#默认关闭，使用 PB configurable_honeycomb
	createComb = false
	#蜜蜂大小
	# Default: 1.2
	# Range: 0.1 ~ 10.0
	size = 1.2
	#飞行速度
	# Default: 0.6
	# Range: 0.01 ~ 10.0
	speed = 0.6
	#攻击伤害
	# Default: 20.0
	# Range: 0.0 ~ 100.0
	attack = 20.0
	#繁殖物品ID
	breedingItem = "productivebees:honey_treat"
	#繁殖所需物品数量
	# Default: 1
	# Range: 1 ~ 64
	breedingItemCount = 1
	#是否可种内繁殖
	selfbreed = true
	#是否防水
	waterproof = true
	#是否防火
	fireproof = true

	[bee_attributes.colors]
		#颜色配置（写入蜜蜂数据并在客户端渲染）
		#主颜色（十六进制，如 #FFD700）
		primaryColor = "#FFFFFF"
		#次要颜色
		secondaryColor = "#FFFFFF"
		#粒子颜色
		particleColor = "#FFFFFF"
		#光晕颜色（十六进制）
		glowColor = "#FFFFFF"

	[bee_attributes.pb_attributes]
		#Productive Bees 独有属性
		#天气耐受性
		#可选值: weather_tolerance.none / weather_tolerance.rain / weather_tolerance.any
		weatherTolerance = "weather_tolerance.any"
		#性格
		#可选值: temper.passive / temper.normal / temper.hostile / temper.aggressive
		temper = "temper.passive"
		#行为
		#可选值: behavior.diurnal (昼行) / behavior.nocturnal (夜行) / behavior.metaturnal (昼夜皆可)
		behavior = "behavior.metaturnal"
		#耐力
		#可选值: endurance.weak / endurance.normal / endurance.medium / endurance.strong
		endurance = "endurance.strong"
		#产量
		#可选值: productivity.normal / productivity.medium / productivity.high / productivity.very_high
		productivity = "productivity.very_high"

#蜜蜂获得方式配置
[bee_acquisition]

	[bee_acquisition.fishing]
		#钓鱼获得万象创世蜜蜂
		#是否启用钓鱼获得万象创世蜜蜂
		enabled = false
		#钓鱼获得蜜蜂的概率（0.0~1.0）
		# Default: 0.1
		# Range: 0.0 ~ 1.0
		chance = 0.1
		#可钓鱼获得蜜蜂的群系列表
		biomes = ["minecraft:ocean", "minecraft:deep_ocean", "minecraft:cold_ocean", "minecraft:deep_cold_ocean", "minecraft:frozen_ocean", "minecraft:deep_frozen_ocean", "minecraft:warm_ocean", "minecraft:lukewarm_ocean", "minecraft:deep_lukewarm_ocean"]

	[bee_acquisition.breeding]
		#繁殖获得万象创世蜜蜂
		#是否启用繁殖获得万象创世蜜蜂
		enabled = true
		#亲代蜜蜂1（注册名，如 productivebees:myriadcreations）
		parent1 = "productivebees:myriadcreations"
		#亲代蜜蜂2（注册名）
		parent2 = "productivebees:myriadcreations"

	[bee_acquisition.spawning]
		#蜂巢生成万象创世蜜蜂
		#是否启用蜂巢自然生成万象创世蜜蜂
		enabled = false
		#生成蜜蜂的蜂巢方块（如 productivebees:stone_nest）
		nest = "productivebees:stone_nest"
		#生成蜜蜂的群系（标签或群系ID，如 #c:is_plains）
		biomes = "#c:is_plains"

#蜜蜂转化配方配置（用其他物品转化获得万象创世）
[bee_conversion]
	#是否启用万象创世的物品转化配方
	enabled = true
	#源蜜蜂类型（注册名，如 minecraft:bee）
	source = "minecraft:bee"
	#转化目标蜜蜂（注册名，如 productivebees:myriadcreations）
	result = "productivebees:myriadcreations"
	#转化所需物品ID（如 minecraft:stick）
	item = "minecraft:stick"
	#转化概率（0.0~1.0）
	# Default: 1.0
	# Range: 0.0 ~ 1.0
	chance = 1.0

#蜜蜂产出配方配置（万象创世蜜脾产出参数）
[bee_produce]
	#是否启用万象创世的蜜脾产出
	enabled = true
	#产出物品ID
	outputItem = "productivebees:configurable_honeycomb"
	#最小产出数量
	# Default: 1
	# Range: 1 ~ 64
	outputMin = 1
	#最大产出数量
	# Default: 1
	# Range: 1 ~ 64
	outputMax = 1
	#产出概率（0.0~1.0）
	# Default: 1.0
	# Range: 0.0 ~ 1.0
	outputChance = 1.0
	#每tick每只蜜蜂最大产物事件数
	#0=无限制，高倍加速时降低CPU
	# Default: 0
	# Range: 0 ~ 20
	myriadProduceThrottlePerTick = 0

#高级蜂箱性能优化（缓解大量模拟蜂箱导致的CPU压力）
[advanced_beehive]
	#模拟行为查询冷却(tick)
	#0=原版，1-5降低高倍加速CPU开销
	# Default: 0
	# Range: 0 ~ 20
	simulateCooldown = 0
	#NBT保存间隔(tick)
	#默认20，值越大性能越好但宕机风险增加
	# Default: 20
	# Range: 1 ~ 200
	saveInterval = 20

#通用机械离心机设置
[mek_centrifuge]

	#基础参数
	[mek_centrifuge.basic]
		#每个处理槽每tick的能量消耗(FE)
		# Default: 50
		# Range: 1 ~ 10000
		energyPerTick = 50
		#机械离心机能量存储容量（FE）
		# Default: 20000
		# Range: 1 ~ 100000000
		energyStorage = 20000
		#基础处理时间(tick)
		# Default: 200
		# Range: 1 ~ 6000
		processingTime = 200
		#流体输出罐基础容量(mB，仅作用于基础离心机)
		#工厂总容量 = 此值 × processes × fluid_tank_multiplier（超过 2.15G mB 时截断）
		# Default: 256000
		# Range: 1000 ~ 1000000
		fluidTankCapacity = 256000
		#是否启用多流体槽模式(按流体类型动态分配独立槽位)
		multiFluidTank = true
		#每种流体类型最大占用槽位数
		#0=自动计算 maxTanks/2（推荐，确保至少 2 种流体可共存）
		#>0=手动指定配额，防止高产出流体占用所有槽位
		# Default: 0
		# Range: 0 ~ 64
		maxTanksPerFluid = 0
		#每 tick 流体弹出速率(mB)
		#Task 6: 配置项允许玩家根据工厂等级调整弹出速率,
		#100-tick CAS 缓存避免 TPS 退化(参考 BeeSlotTickProcessor.refreshConfigCache)
		#范围 1-10240,默认 256
		# Default: 256
		# Range: 1 ~ 10240
		fluidEjectRate = 256
		#万象创世蜜脾块相对于蜜脾的产物倍率
		# Default: 4
		# Range: 1 ~ 16
		combBlockMultiplier = 4
		#单tick最大PB配方操作数（0=无限制，允许堆叠升级 2^N 并行效果完整生效）
		# Default: 0
		# Range: 0 ~ 1000000
		maxOpsPerTick = 0

	#弹出策略
	[mek_centrifuge.ejection]
		#输出槽自动弹出延迟(tick，原版 10，推荐 2)
		# Default: 2
		# Range: 0 ~ 20
		ejectDelay = 2
		#输出槽仍有物品时的弹出延迟(tick，推荐 1，不超过 ejectDelay)
		# Default: 1
		# Range: 0 ~ 20
		ejectDelayActive = 1
		#输出槽内容未变化时跳过 Ejector 输出以降低 CPU 开销
		ejectSkipUnchanged = true
		#输出未变化时连续跳过的 tick 数（0=不跳过）
		# Default: 1
		# Range: 0 ~ 20
		ejectSkipTicks = 1
		#最大弹出速度模式（跳过节流逻辑，需目标容器空间充足）
		ejectMaxSpeedMode = false
		#输出持续变化时两次调用的最小间隔（0=关闭）
		# Default: 0
		# Range: 0 ~ 20
		ejectMinInterval = 0
		#连续未减少输出总量多少次后进入长冷却
		# Default: 5
		# Range: 1 ~ 50
		ejectBusyThreshold = 5
		#高负载长冷却跳过的 tick 数（0=关闭）
		# Default: 40
		# Range: 0 ~ 600
		ejectBusyCooldown = 40
		#单 tick 最大 outputItems 调用次数（0=无限制，最大速度模式下跳过）
		# Default: 64
		# Range: 0 ~ 4096
		ejectMaxPerTick = 64
		#连续未弹出物品多少次后进入冷却
		# Default: 3
		# Range: 1 ~ 20
		ejectBlockedThreshold = 3
		#阻塞冷却跳过的 tick 数（0=关闭）
		# Default: 15
		# Range: 0 ~ 200
		ejectBlockedCooldown = 15

	#IO 限流
	[mek_centrifuge.io_limit]
		#每tick外部通过管道/AE2拉取的最大物品数（0=无限制）
		# Default: 0
		# Range: 0 ~ 1024
		maxExtractPerTick = 0

	#输出槽堆叠倍率（按离心机等级）
	#基础堆叠 64/槽 | 单槽容量 = 64 × 倍率 | 工厂总容量 = 64 × 倍率 × processes × 3（每进程 3 输出槽）
	#输出槽倍率默认为输入槽的 4 倍（蜜脾处理成倍产出）
	[mek_centrifuge.stack_multiplier]
		#基础离心机（3 进程，9 输出槽）
		#默认 65536× → 单槽 4,194,304 (4.2M) | 工厂总 37,748,736 (37.7M)
		# Default: 65536
		# Range: 1 ~ 10000000
		basic = 65536
		#高级离心机（5 进程，15 输出槽）
		#默认 327680× → 单槽 20,971,520 (21.0M) | 工厂总 314,572,800 (314.6M)
		# Default: 327680
		# Range: 1 ~ 10000000
		advanced = 327680
		#精英离心机（7 进程，21 输出槽）
		#默认 458752× → 单槽 29,360,128 (29.4M) | 工厂总 616,562,688 (616.6M)
		# Default: 458752
		# Range: 1 ~ 10000000
		elite = 458752
		#终极离心机（9 进程，27 输出槽）
		#默认 589824× → 单槽 37,748,736 (37.7M) | 工厂总 1,019,215,872 (1.0G)
		# Default: 589824
		# Range: 1 ~ 10000000
		ultimate = 589824
		#通用机械:扩展 绝对离心机（11 进程，33 输出槽）
		#默认 720896× → 单槽 46,137,344 (46.1M) | 工厂总 1,522,532,352 (1.5G)
		# Default: 720896
		# Range: 1 ~ 10000000
		meAbsolute = 720896
		#通用机械:扩展 至尊离心机（13 进程，39 输出槽）
		#默认 851968× → 单槽 54,525,952 (54.5M) | 工厂总 2,126,562,048 (2.1G)
		# Default: 851968
		# Range: 1 ~ 10000000
		meSupreme = 851968
		#通用机械:扩展 寰宇离心机（15 进程，45 输出槽）
		#默认 983040× → 单槽 62,914,560 (62.9M) | 工厂总 2,831,155,200 (2.8G)
		# Default: 983040
		# Range: 1 ~ 10000000
		meCosmic = 983040
		#通用机械:扩展 无限离心机（17 进程，51 输出槽）
		#默认 1114112× → 单槽 71,303,168 (71.3M) | 工厂总 3,636,461,568 (3.6G)
		# Default: 1114112
		# Range: 1 ~ 10000000
		meInfinite = 1114112
		#进化通用机械:扩展 绝对超频离心机（12 进程，36 输出槽）
		#默认 786432× → 单槽 50,331,648 (50.3M) | 工厂总 1,815,713,792 (1.8G)
		# Default: 786432
		# Range: 1 ~ 10000000
		emeAbsoluteOverclocked = 786432
		#进化通用机械:扩展 至尊量子离心机（14 进程，42 输出槽）
		#默认 917504× → 单槽 58,720,256 (58.7M) | 工厂总 2,466,916,608 (2.5G)
		# Default: 917504
		# Range: 1 ~ 10000000
		emeSupremeQuantum = 917504
		#进化通用机械:扩展 寰宇致密离心机（16 进程，48 输出槽）
		#默认 1048576× → 单槽 67,108,864 (67.1M) | 工厂总 3,221,225,472 (3.2G)
		# Default: 1048576
		# Range: 1 ~ 10000000
		emeCosmicDense = 1048576
		#进化通用机械:扩展 无限多元离心机（18 进程，54 输出槽）
		#默认 1179648× → 单槽 75,497,472 (75.5M) | 工厂总 4,076,866,560 (4.1G)
		# Default: 1179648
		# Range: 1 ~ 10000000
		emeInfiniteMultiversal = 1179648

	#输入槽堆叠倍率（按离心机等级）
	#基础堆叠 64/槽 | 单槽容量 = 64 × 倍率 | 工厂总容量 = 64 × 倍率 × processes
	#蜜脾处理成倍产出，输入槽默认倍率为输出槽的 1/4
	[mek_centrifuge.input_stack_multiplier]
		#基础离心机（3 进程）
		#默认 16384× → 单槽 1,048,576 (1.0M) | 工厂总 3,145,728 (3.1M)
		# Default: 16384
		# Range: 1 ~ 10000000
		basic = 16384
		#高级离心机（5 进程）
		#默认 81920× → 单槽 5,242,880 (5.2M) | 工厂总 26,214,400 (26.2M)
		# Default: 81920
		# Range: 1 ~ 10000000
		advanced = 81920
		#精英离心机（7 进程）
		#默认 114688× → 单槽 7,340,032 (7.3M) | 工厂总 51,380,224 (51.4M)
		# Default: 114688
		# Range: 1 ~ 10000000
		elite = 114688
		#终极离心机（9 进程）
		#默认 147456× → 单槽 9,437,184 (9.4M) | 工厂总 84,934,656 (84.9M)
		# Default: 147456
		# Range: 1 ~ 10000000
		ultimate = 147456
		#通用机械:扩展 绝对离心机（11 进程）
		#默认 180224× → 单槽 11,534,336 (11.5M) | 工厂总 126,877,696 (126.9M)
		# Default: 180224
		# Range: 1 ~ 10000000
		meAbsolute = 180224
		#通用机械:扩展 至尊离心机（13 进程）
		#默认 212992× → 单槽 13,631,488 (13.6M) | 工厂总 177,209,344 (177.2M)
		# Default: 212992
		# Range: 1 ~ 10000000
		meSupreme = 212992
		#通用机械:扩展 寰宇离心机（15 进程）
		#默认 245760× → 单槽 15,728,640 (15.7M) | 工厂总 235,929,600 (235.9M)
		# Default: 245760
		# Range: 1 ~ 10000000
		meCosmic = 245760
		#通用机械:扩展 无限离心机（17 进程）
		#默认 278528× → 单槽 17,825,792 (17.8M) | 工厂总 303,038,464 (303.0M)
		# Default: 278528
		# Range: 1 ~ 10000000
		meInfinite = 278528
		#进化通用机械:扩展 绝对超频离心机（12 进程）
		#默认 196608× → 单槽 12,582,912 (12.6M) | 工厂总 150,994,944 (151.0M)
		# Default: 196608
		# Range: 1 ~ 10000000
		emeAbsoluteOverclocked = 196608
		#进化通用机械:扩展 至尊量子离心机（14 进程）
		#默认 229376× → 单槽 14,680,064 (14.7M) | 工厂总 205,520,896 (205.5M)
		# Default: 229376
		# Range: 1 ~ 10000000
		emeSupremeQuantum = 229376
		#进化通用机械:扩展 寰宇致密离心机（16 进程）
		#默认 262144× → 单槽 16,777,216 (16.8M) | 工厂总 268,435,456 (268.4M)
		# Default: 262144
		# Range: 1 ~ 10000000
		emeCosmicDense = 262144
		#进化通用机械:扩展 无限多元离心机（18 进程）
		#默认 294912× → 单槽 18,874,368 (18.9M) | 工厂总 339,738,624 (339.7M)
		# Default: 294912
		# Range: 1 ~ 10000000
		emeInfiniteMultiversal = 294912

	#流体罐倍率（按离心机等级）
	#基础容量 256K mB (256 桶)/进程 | 单进程容量 = 256K × 倍率 | 工厂总容量 = 256K × processes × 倍率
	#超过 Integer.MAX_VALUE (2,147,483,647 mB ≈ 2.15G mB / 2,147,483 桶) 时截断
	[mek_centrifuge.fluid_tank_multiplier]
		#基础离心机（3 进程）
		#默认 1× → 单进程 256K mB (256 桶) | 工厂总 768K mB (768 桶)
		# Default: 1
		# Range: 1 ~ 10000000
		basic = 1
		#高级离心机（5 进程）
		#默认 2× → 单进程 512K mB (512 桶) | 工厂总 2.56M mB (2,560 桶)
		# Default: 2
		# Range: 1 ~ 10000000
		advanced = 2
		#精英离心机（7 进程）
		#默认 4× → 单进程 1.02M mB (1,024 桶) | 工厂总 7.17M mB (7,168 桶)
		# Default: 4
		# Range: 1 ~ 10000000
		elite = 4
		#终极离心机（9 进程）
		#默认 8× → 单进程 2.05M mB (2,048 桶) | 工厂总 18.4M mB (18,432 桶)
		# Default: 8
		# Range: 1 ~ 10000000
		ultimate = 8
		#通用机械:扩展 绝对离心机（11 进程）
		#默认 16× → 单进程 4.10M mB (4,096 桶) | 工厂总 45.1M mB (45,056 桶)
		# Default: 16
		# Range: 1 ~ 10000000
		meAbsolute = 16
		#通用机械:扩展 至尊离心机（13 进程）
		#默认 32× → 单进程 8.19M mB (8,192 桶) | 工厂总 106.5M mB (106,496 桶)
		# Default: 32
		# Range: 1 ~ 10000000
		meSupreme = 32
		#通用机械:扩展 寰宇离心机（15 进程）
		#默认 64× → 单进程 16.4M mB (16,384 桶) | 工厂总 245.8M mB (245,760 桶)
		# Default: 64
		# Range: 1 ~ 10000000
		meCosmic = 64
		#通用机械:扩展 无限离心机（17 进程）
		#默认 128× → 单进程 32.8M mB (32,768 桶) | 工厂总 557.1M mB (557,056 桶)
		# Default: 128
		# Range: 1 ~ 10000000
		meInfinite = 128
		#进化通用机械:扩展 绝对超频离心机（12 进程）
		#默认 4096× → 单进程 1.05G mB (1,048,576 桶) | 工厂总 12.58G mB → 截断 2.15G mB (2,147,483 桶)
		# Default: 4096
		# Range: 1 ~ 10000000
		emeAbsoluteOverclocked = 4096
		#进化通用机械:扩展 至尊量子离心机（14 进程）
		#默认 8192× → 单进程 2.10G mB (2,097,152 桶) | 工厂总 29.36G mB → 截断 2.15G mB (2,147,483 桶)
		# Default: 8192
		# Range: 1 ~ 10000000
		emeSupremeQuantum = 8192
		#进化通用机械:扩展 寰宇致密离心机（16 进程）
		#默认 16384× → 单进程 4.19G mB (4,194,304 桶) | 工厂总 67.11G mB → 截断 2.15G mB (2,147,483 桶)
		# Default: 16384
		# Range: 1 ~ 10000000
		emeCosmicDense = 16384
		#进化通用机械:扩展 无限多元离心机（18 进程）
		#默认 32768× → 单进程 8.39G mB (8,388,608 桶) | 工厂总 150.99G mB → 截断 2.15G mB (2,147,483 桶)
		# Default: 32768
		# Range: 1 ~ 10000000
		emeInfiniteMultiversal = 32768

	#AE2 集成
	[mek_centrifuge.ae2]
		#启用 AE2 直接输出（推送输出槽物品到 AE2 网络）
		aeOutputEnabled = true
		#启用 AE2 流体输出（推送蜂蜜到 AE2 网络，独立于物品输出）
		aeFluidOutputEnabled = true
		#启用 AE 网络能量输入（从 ME 网络提取 FE 注入本地能量容器）
		#默认开启
		aeEnergyInputEnabled = true
		#AE 网络能量优先级（true=优先 AppliedFlux，false=优先 AE2 原生能量）
		preferAppliedFluxOverAeEnergy = true
		#启用 AE2 输入拉取（离心机主动从 ME 网络拉取输入物品）
		#默认开启；每台离心机默认关闭，需在机器上单独开启
		aeInputEnabled = true
		#每次拉取最大物品数量（1-16384，过大可能增加 CPU 开销）
		# Default: 1024
		# Range: 1 ~ 16384
		aeInputRatePerTick = 1024
		#拉取触发间隔（游戏刻，值越大 CPU 开销越低但响应越慢）
		# Default: 10
		# Range: 1 ~ 200
		aeInputIntervalTicks = 10
		#AE2 输入过滤窗口最小页数（1-16）
		# Default: 4
		# Range: 1 ~ 16
		aeInputMinPages = 4

	#PB升级上限
	[mek_centrifuge.pb_upgrade]
		#产量升级（α/β/γ/Ω）最大安装数量
		# Default: 8
		# Range: 1 ~ 64
		productivityMaxCount = 8
		#时间升级最大安装数量
		# Default: 8
		# Range: 1 ~ 64
		timeMaxCount = 8
		#稳定性升级最大安装数量（仅离心机生效，对齐 PB 原版上限 7）
		#每级 +0.15 非保底产物概率加成，满槽（7个）时所有概率产物变保底
		# Default: 7
		# Range: 1 ~ 7
		stabilityMaxCount = 7

	#通用机械:扩展 升级上限
	[mek_centrifuge.me_upgrade]
		#通用机械:扩展 堆叠升级最大数量（2^N 倍并行，仅作用于本模组离心机工厂）
		# Default: 16
		# Range: 8 ~ 32
		maxStackUpgrades = 16

	#离心机电力熔炼炉配方兼容（总开关）
	[mek_centrifuge.smelting_compat]
		#允许离心机处理电力熔炼炉（SMELTING）配方
		#默认开启；关闭后所有离心机的熔炉配方兼容开关无法使用
		#每台离心机是否兼容熔炉配方由 GUI 中的 per-tile 开关控制，默认关闭
		smeltingCompatEnabled = true

#通用机械蜂箱设置
[mek_apiary]

	#基础参数
	[mek_apiary.basic]
		#每个处理槽每tick的能量消耗(FE)
		# Default: 50
		# Range: 1 ~ 1000000
		energyPerTick = 50
		#基础处理时间(tick)
		# Default: 1200
		# Range: 1 ~ 6000
		processingTime = 1200
		#基础版蜂箱流体罐容量(mB，仅作用于基础版蜂箱)
		#工厂版按等级硬编码：每级 +256K mB（基础 256K → EME 无限多元 3.07M）
		# Default: 256000
		# Range: 1000 ~ 1000000
		fluidTankCapacity = 256000

	#弹出策略
	[mek_apiary.ejection]
		#输出槽自动弹出延迟(tick，推荐 2=0.1 秒)
		# Default: 2
		# Range: 0 ~ 20
		ejectDelay = 2
		#输出槽仍有物品时的弹出延迟(tick，推荐 1=0.05 秒)
		# Default: 1
		# Range: 0 ~ 20
		ejectDelayActive = 1
		#最大弹出速度模式（跳过节流逻辑，需目标容器空间充足）
		ejectMaxSpeedMode = false
		#单 tick 最大弹出次数（0=无限制，最大速度模式下跳过）
		# Default: 64
		# Range: 0 ~ 4096
		ejectMaxPerTick = 64
		#连续未弹出物品多少次后进入冷却
		# Default: 3
		# Range: 1 ~ 20
		ejectBlockedThreshold = 3
		#阻塞冷却跳过的 tick 数（0=关闭）
		# Default: 15
		# Range: 0 ~ 200
		ejectBlockedCooldown = 15

	#输出槽堆叠倍率（按工厂等级，仅作用于产物输出槽）
	#基础堆叠 64/槽 | 单槽容量 = 64 × 倍率 | 工厂总容量 = 64 × 倍率 × outputSlotCount
	#outputSlotCount：基础 9 / 高级 12 / 精英 15 / 终极 18 / 扩展等级每级 +3
	[mek_apiary.stack_multiplier]
		#基础蜂箱（3 进程，9 输出槽）
		#默认 1× → 单槽 64 (64) | 工厂总 576 (576)
		# Default: 1
		# Range: 1 ~ 100000
		basic = 1
		#高级蜂箱（5 进程，12 输出槽）
		#默认 2× → 单槽 128 (128) | 工厂总 1,536 (1.5K)
		# Default: 2
		# Range: 1 ~ 100000
		advanced = 2
		#精英蜂箱（7 进程，15 输出槽）
		#默认 4× → 单槽 256 (256) | 工厂总 3,840 (3.8K)
		# Default: 4
		# Range: 1 ~ 100000
		elite = 4
		#终极蜂箱（9 进程，18 输出槽）
		#默认 8× → 单槽 512 (512) | 工厂总 9,216 (9.2K)
		# Default: 8
		# Range: 1 ~ 100000
		ultimate = 8
		#通用机械:扩展 绝对蜂箱（11 进程，21 输出槽）
		#默认 16× → 单槽 1,024 (1.0K) | 工厂总 21,504 (21.5K)
		# Default: 16
		# Range: 1 ~ 100000
		meAbsolute = 16
		#通用机械:扩展 至尊蜂箱（13 进程，24 输出槽）
		#默认 32× → 单槽 2,048 (2.0K) | 工厂总 49,152 (49.2K)
		# Default: 32
		# Range: 1 ~ 100000
		meSupreme = 32
		#通用机械:扩展 寰宇蜂箱（15 进程，27 输出槽）
		#默认 64× → 单槽 4,096 (4.1K) | 工厂总 110,592 (110.6K)
		# Default: 64
		# Range: 1 ~ 100000
		meCosmic = 64
		#通用机械:扩展 无限蜂箱（17 进程，30 输出槽）
		#默认 128× → 单槽 8,192 (8.2K) | 工厂总 245,760 (245.8K)
		# Default: 128
		# Range: 1 ~ 100000
		meInfinite = 128
		#进化通用机械:扩展 绝对超频蜂箱（12 进程，33 输出槽）
		#默认 256× → 单槽 16,384 (16.4K) | 工厂总 540,672 (540.7K)
		# Default: 256
		# Range: 1 ~ 100000
		emeAbsoluteOverclocked = 256
		#进化通用机械:扩展 至尊量子蜂箱（14 进程，36 输出槽）
		#默认 512× → 单槽 32,768 (32.8K) | 工厂总 1,179,648 (1.2M)
		# Default: 512
		# Range: 1 ~ 100000
		emeSupremeQuantum = 512
		#进化通用机械:扩展 寰宇致密蜂箱（16 进程，39 输出槽）
		#默认 1024× → 单槽 65,536 (65.5K) | 工厂总 2,555,904 (2.6M)
		# Default: 1024
		# Range: 1 ~ 100000
		emeCosmicDense = 1024
		#进化通用机械:扩展 无限多元蜂箱（18 进程，42 输出槽）
		#默认 4096× → 单槽 262,144 (262.1K) | 工厂总 11,010,048 (11.0M)
		# Default: 4096
		# Range: 1 ~ 1000000
		emeInfiniteMultiversal = 4096

	#AE2 集成
	[mek_apiary.ae2]
		#启用 AE2 直接输出（推送输出槽物品到 AE2 网络）
		aeOutputEnabled = true
		#启用 AE2 流体输出（推送蜂蜜流体到 AE2 网络）
		aeFluidOutputEnabled = true
		#启用 AE 网络能量输入（从 ME 网络提取 FE 注入本地能量容器）
		aeEnergyInputEnabled = true
		#AE 网络能量优先级（true=优先 AppliedFlux，false=优先 AE2 原生能量）
		preferAppliedFluxOverAeEnergy = true

	#PB升级上限
	[mek_apiary.pb_upgrade]
		#产量升级（α/β/γ/Ω）最大安装数量
		# Default: 8
		# Range: 1 ~ 64
		productivityMaxCount = 8
		#时间升级最大安装数量
		# Default: 8
		# Range: 1 ~ 64
		timeMaxCount = 8
		#基因采样升级最大安装数量
		# Default: 4
		# Range: 1 ~ 20
		geneSamplerMaxCount = 4
		#蜜脾块升级最大安装数量
		# Default: 1
		# Range: 1 ~ 1
		blockMaxCount = 1
