#Undying Totem Capacitor Settings
[UndyingTotemCapacitor]
	#Enable custom calculation logic for the Undying Totem Capacitor.
	#If false, it uses the hardcoded vanilla tier logic.
	enableCustomMath = false

	#Efficiency Enchantment Settings
	[UndyingTotemCapacitor.EfficiencySettings]
		#Base capacitor level.
		# Default: 3.5
		# Range: 0.0 ~ 100.0
		baseLevel = 3.5
		#Level increment per Enchantment.
		# Default: 0.5
		# Range: 0.0 ~ 100.0
		levelIncrementPerEnchant = 0.5
		#Max enchantment limit (-1 for unlimited).
		# Default: 5
		# Range: -1 ~ 255
		maxEnchantLimit = 5

	#Unbreaking Enchantment Settings
	[UndyingTotemCapacitor.UnbreakingSettings]
		#Lifespan % added per Unbreaking level.
		# Default: 13.3
		# Range: 0.0 ~ 1000.0
		unbreakingIncrementPercent = 13.3
		#Max Unbreaking limit (-1 for unlimited).
		# Default: 3
		# Range: -1 ~ 255
		maxUnbreakingLimit = 3
