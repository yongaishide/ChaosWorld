#Machine Utilization Multipliers for Upgrades
[Utilization]

	[Utilization.SAG_MILL]
		# Default: 1.0
		# Range: 0.0 ~ 100.0
		stackUtilization = 1.0
		# Default: 1.0
		# Range: 0.0 ~ 100.0
		batchUtilization = 1.0

	[Utilization.ALLOY_SMELTER]
		# Default: 3.0
		# Range: 0.0 ~ 100.0
		stackUtilization = 3.0
		# Default: 1.0
		# Range: 0.0 ~ 100.0
		batchUtilization = 1.0

	[Utilization.VAT]
		# Default: 1.0
