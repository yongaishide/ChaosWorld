#Generators Settings
[Generators]

	[Generators.SimpleStirlingGenerator]
		#Base generation rate (RF/t).
		# Default: 30
		# Range: 1 ~ 1000000
		baseGeneration = 30
		#Fuel burning efficiency multiplier.
		# Default: 0.8
		# Range: 0.1 ~ 10.0
		fuelEfficiency = 0.8

		[Generators.InfinityGenerator.basic_infinity_generator]
			#Base RF/t for this tier.
			# Default: 20
			# Range: > 1
			baseGeneration = 20
			#Extra generation multiplier (e.g. 1.2 = 120%).
			# Default: 1.0
			# Range: 0.1 ~ 100.0
			tierBonus = 1.0

		[Generators.InfinityGenerator.crystalline_infinity_generator]
			#Base RF/t for this tier.
			# Default: 100
			# Range: > 1
			baseGeneration = 100
			#Extra generation multiplier (e.g. 1.2 = 120%).
			# Default: 1.2
			# Range: 0.1 ~ 100.0
			tierBonus = 1.2

		[Generators.InfinityGenerator.stellar_infinity_generator]
			#Base RF/t for this tier.
			# Default: 300
			# Range: > 1
			baseGeneration = 300
			#Extra generation multiplier (e.g. 1.2 = 120%).
			# Default: 1.5
			# Range: 0.1 ~ 100.0
			tierBonus = 1.5
