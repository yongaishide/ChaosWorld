#JDT Extras Settings
[jdte]

	#Upgrade System Settings
	[jdte.upgrades]
		#Number of extra filter slots per filter upgrade card
		# Default: 9
		# Range: 1 ~ 27
		filterSlotsPerUpgrade = 9
		#Underclock energy cost multiplier (0.2 = 20% of original)
		# Default: 0.2
		# Range: 0.01 ~ 1.0
		underclockEnergyMultiplier = 0.2
		#Overclock energy cost multiplier (3 = 3x original)
		# Default: 3
		# Range: 1 ~ 10
		overclockEnergyMultiplier = 3
		#Underclock tick speed (locks machine to this tick interval)
		# Default: 40
		# Range: 1 ~ 100
		underclockTickSpeed = 40
		#Overclock tick speed (locks machine to this tick interval)
		# Default: 1
		# Range: 1 ~ 10
		overclockTickSpeed = 1
		#Base area radius for range upgrade
		# Default: 5.0
		# Range: 1.0 ~ 50.0
		baseAreaRadius = 5.0
		#Base area offset for range upgrade
		# Default: 9
		# Range: 0 ~ 50
		baseAreaOffset = 9

	#Time Accelerator Settings
	[jdte.timeAccelerator]
		#Base fluid capacity for time accelerators (mB)
		# Default: 1000
		# Range: 100 ~ 100000
		timeAcceleratorBaseFluidCapacity = 1000
		#Time accelerator fluid cost multiplier. 1.0 matches the JDT Time Wand cost spread over 30 seconds.
		# Default: 1.0
		# Range: 0.0 ~ 1000.0
		timeAcceleratorFluidCostMultiplier = 1.0
		#Basic time accelerator default multiplier
		# Default: 16
		# Range: 1 ~ 100
		basicTimeAcceleratorDefaultMultiplier = 16
		#Basic time accelerator overclock multiplier
		# Default: 32
		# Range: 1 ~ 1000
		basicTimeAcceleratorOverclockMultiplier = 32
		#Advanced time accelerator energy capacity
		# Default: 200000
		# Range: 10000 ~ 10000000
		advancedTimeAcceleratorEnergyCapacity = 200000
		#Advanced time accelerator max adjustable multiplier
		# Default: 64
		# Range: 1 ~ 1000
		advancedTimeAcceleratorMaxMultiplier = 64
		#Advanced time accelerator overclock multiplier
		# Default: 128
		# Range: 1 ~ 10000
		advancedTimeAcceleratorOverclockMultiplier = 128
		#Advanced time accelerator default multiplier
		# Default: 4
		# Range: 1 ~ 100
		advancedTimeAcceleratorDefaultMultiplier = 4
		#Extended time accelerator maximum adjustable multiplier
		# Default: 512
		# Range: 1 ~ 10000
		extendedTimeAcceleratorMaxMultiplier = 512
		#Extended time accelerator multiplier with Overclock or Creative Upgrade
		# Default: 1024
		# Range: 1 ~ 100000
		extendedTimeAcceleratorOverclockMultiplier = 1024
		#Maximum managed virtual ticks executed per server tick. Work above this limit remains queued.
		# Default: 4096
		# Range: 1 ~ 1000000
		timeAcceleratorMaxExecutionsPerTick = 4096
		#Maximum random-ticking block positions scanned per server tick
		# Default: 16384
		# Range: 256 ~ 1000000
		timeAcceleratorMaxScannedBlocksPerTick = 16384
		#Maximum paid virtual ticks retained per Time Accelerator target
		# Default: 1000000
		# Range: 1024 ~ 100000000
		timeAcceleratorMaxPendingTicks = 1000000
		#Maximum virtual ticks processed for one target before rotating to the next target
		# Default: 64
		# Range: 1 ~ 4096
		timeAcceleratorExecutionBatchSize = 64
		#Ticks between random-ticking block target cache refreshes
		# Default: 20
		# Range: 1 ~ 1200
		timeAcceleratorRandomRefreshInterval = 20
		#Allow Time Accelerators with an AE Acceleration Upgrade to invoke AE2 IGridTickable services
		timeAcceleratorAE2Enabled = true
		#Ultimate Time Wand Time Fluid capacity (mB)
		# Default: 800000
		# Range: 1000 ~ 100000000
		ultimateTimeWandFluidCapacity = 800000
		#Ultimate Time Wand FE capacity
		# Default: 10000000
		# Range: 10000 ~ 1000000000
		ultimateTimeWandEnergyCapacity = 10000000
		#Ultimate Time Wand effect duration (ticks)
		# Default: 600
		# Range: 1 ~ 1000000
		ultimateTimeWandDuration = 600
		#Ultimate Time Wand base multiplier cost multiplier
		# Default: 1.0
		# Range: 0.0 ~ 1000000.0
		ultimateTimeWandBaseCostMultiplier = 1.0
		#Ultimate Time Wand FE base cost multiplier
		# Default: 1.0
		# Range: 0.0 ~ 1000000.0
		ultimateTimeWandEnergyCostMultiplier = 1.0
		#Keep fractional Ultimate Time Wand fluid cost between settlements
		ultimateTimeWandFractionalFluidSettlement = true

	#Bio Crusher Settings
	[jdte.bioCrusher]
		#Base fluid capacity for bio crusher (mB)
		# Default: 16000
		# Range: 1000 ~ 1000000
		bioCrusherFluidCapacity = 16000
		#Base energy cost per operation
		# Default: 300
		# Range: 10 ~ 100000
		bioCrusherEnergyCost = 300
		#Base search radius for bio crusher
		# Default: 2.5
		# Range: 1.0 ~ 20.0
		bioCrusherBaseRadius = 2.5
		#Experience fluid produced per actual experience point dropped by the entity (mB)
		# Default: 1.0
		# Range: 0.0 ~ 10000.0
		experienceFluidPerPoint = 1.0
		#Multiplier applied to the base output slots opened by each Capacity Upgrade (base is 9 slots per upgrade)
		# Default: 2
		# Range: 1 ~ 10
		bioCrusherOutputSlotsPerCapacityUpgradeMultiplier = 2
		#Base damage dealt by bio crusher
		# Default: 5
		# Range: 1 ~ 1000
		bioCrusherBaseDamage = 5
		#Base interval in ticks between bio crusher operations
		# Default: 5
		# Range: 1 ~ 200
		bioCrusherProcessTime = 5
		#When enabled, the bio crusher will not force-kill entities that survive its FakePlayer attack. Disabled by default so protected bosses can still be processed.
		respectDamageRestrictions = false
		#Allow Bio Crushers to automatically destroy Draconic Evolution Chaos Guardian Crystals. Disabled by default.
		allowDestroyChaosGuardianCrystals = false
		#Allow Bio Crushers to instantly kill the Draconic Evolution Chaos Guardian with FakePlayer attribution. Disabled by default.
		allowInstantKillChaosGuardian = false
		#Looting extra drop chance per level (0.5 = 50%)
		# Default: 0.5
		# Range: 0.01 ~ 1.0
		lootingExtraDropChance = 0.5
		#Advanced bio crusher energy capacity
		# Default: 100000
		# Range: 10000 ~ 10000000
		advancedBioCrusherEnergyCapacity = 100000
		#Extended bio crusher energy capacity
		# Default: 200000
		# Range: 10000 ~ 10000000
		extendedBioCrusherEnergyCapacity = 200000
		#Max entities processed per tick (advanced)
		# Default: 2
		# Range: 1 ~ 100
		advancedBioCrusherMaxEntities = 2
		#Max entities processed per tick (extended)
		# Default: 4
		# Range: 1 ~ 100
		extendedBioCrusherMaxEntities = 4

	#Life Extractor Settings
	[jdte.lifeExtractor]
		#Life Fluid produced per point of the entity's current health (mB)
		# Default: 0.1
		# Range: 0.001 ~ 100000.0
		fluidPerHealth = 0.1
		#Marginal yield loss for each complete 100-health band above the first 100 health
		# Default: 10.0
		# Range: 0.0 ~ 100.0
		highHealthLossPercent = 10.0

	#Loot Fabricator Settings
	[jdte.lootFabricator]
		#Base Time Fluid cost per successful operation in fifths of one mB. Faster machine speeds multiply this cost; fractional costs carry across operations without loss.
		# Default: 1
		# Range: 1 ~ 1000000
		baseTimeFluidCost = 1
		#Additional Life Fluid and Time Fluid cost per Looting Upgrade installed in a Loot Fabricator, in percent.
		# Default: 50
		# Range: 0 ~ 10000
		lootingFluidCostIncreasePercent = 50
		#Life Fluid consumed per successful loot fabrication operation (mB)
		# Default: 20
		# Range: 1 ~ 1000000
		lifeFluidCostV2 = 20
		#When disabled, dynamic Loot Fabricator JEI recipes are not generated; the machine remains usable.
		recipeGenerationEnabled = true

	#Sender/Receiver Settings
	[jdte.senderReceiver]
		#Internal storage slots for item sender/receiver
		# Default: 9
		# Range: 1 ~ 54
		senderStorageSlots = 9
		#Advanced item sender energy capacity
		# Default: 50000
		# Range: 1000 ~ 10000000
		advancedItemSenderEnergyCapacity = 50000
		#Advanced item sender energy cost per cycle
		# Default: 500
		# Range: 10 ~ 100000
		advancedItemSenderEnergyCost = 500
		#Extended item sender energy capacity
		# Default: 100000
		# Range: 1000 ~ 10000000
		extendedItemSenderEnergyCapacity = 100000
		#Advanced fluid sender energy capacity
		# Default: 50000
		# Range: 1000 ~ 10000000
		advancedFluidSenderEnergyCapacity = 50000
		#Advanced fluid sender energy cost per cycle
		# Default: 500
		# Range: 10 ~ 100000
		advancedFluidSenderEnergyCost = 500
		#Extended fluid sender energy capacity
		# Default: 100000
		# Range: 1000 ~ 10000000
		extendedFluidSenderEnergyCapacity = 100000
		#Fluid sender/receiver base fluid capacity (mB)
		# Default: 8000
		# Range: 100 ~ 1000000
		fluidSenderFluidCapacity = 8000
		#When enabled, Fluid Senders move all available internal fluid per operation instead of using the configured fluid batch limits
		fluidSenderUnlimitedTransfer = true
		#Maximum items transferred per side and auto I/O operation. Default matches Logistics Network's Netherite tier.
		# Default: 10000
		# Range: 1 ~ 1000000
		autoIoItemTransferRate = 10000
		#Maximum fluid transferred per side and auto I/O operation in mB. Default matches Logistics Network's Netherite tier.
		# Default: 1000000
		# Range: > 1
		autoIoFluidTransferRate = 1000000
		#Maximum items moved per sender/receiver operation without Overclock. Default matches Logistics Network's Diamond tier.
		# Default: 64
		# Range: 1 ~ 1000000
		senderReceiverItemTransferRate = 64
		#Maximum items moved per sender/receiver operation with Overclock or Creative. Default matches Logistics Network's Netherite tier.
		# Default: 10000
		# Range: 1 ~ 1000000
		senderReceiverOverclockItemTransferRate = 10000
		#Maximum fluid moved per sender/receiver operation without Overclock in mB. Default matches Logistics Network's Diamond tier.
		# Default: 20000
		# Range: > 1
		senderReceiverFluidTransferRate = 20000
		#Maximum fluid moved per sender/receiver operation with Overclock or Creative in mB. Default matches Logistics Network's Netherite tier.
		# Default: 1000000
		# Range: > 1
		senderReceiverOverclockFluidTransferRate = 1000000
		#Initial idle retry delay for auto I/O and sender/receiver transfers in ticks
		# Default: 10
		# Range: 1 ~ 200
		transferFailureBackoffStart = 10
		#Maximum idle retry delay for auto I/O and sender/receiver transfers in ticks
		# Default: 40
		# Range: 1 ~ 1200
		transferFailureBackoffMax = 40

	#Advanced Item Collector Settings
	[jdte.advancedItemCollector]
		#Directly transfer oversized container slots before player block breaking creates item entities
		preDrainEnabled = true
		#Minimum item count in one source slot that enables pre-break direct transfer
		# Default: 10000000
		# Range: > 65
		preDrainThreshold = 10000000
		#Use direct AE2 ME storage insertion when the attached interface item handler cannot accept a complete collected stack
		meDirectTransferEnabled = true
		#Periodically collect item entities that already exist in configured collector areas
		existingItemScanEnabled = true
		#Minimum ticks between existing-item scans for each collector
		# Default: 10
		# Range: 1 ~ 1200
		existingItemScanInterval = 10
		#Maximum existing item entities processed by one collector scan
		# Default: 256
		# Range: 1 ~ 4096
		existingItemScanLimit = 256

	#Entity Suppressor Settings
	[jdte.entitySuppressor]
		# Default: 200000
		# Range: 1000 ~ 100000000
		energyCapacity = 200000
		# Default: 250
		# Range: 0 ~ 1000000
		energyPerTick = 250
		protectNamed = true
		protectTamed = true
		protectBosses = true
		#Periodically remove matching existing entities while Block Entities mode is active
		removeExistingEntities = false

	#Range Blocker Settings
	[jdte.rangeBlocker]
		# Default: 200000
		# Range: 1000 ~ 100000000
		energyCapacity = 200000
		# Default: 250
		# Range: 0 ~ 1000000
		containmentEnergyPerTick = 250
		#FE consumed per active Demagnetization tick
		# Default: 1
		# Range: 0 ~ 1000000
		demagnetizationEnergyPerTick = 1
		#FE consumed every tick while Silence mode is active
		# Default: 1
		# Range: 0 ~ 1000000
		silenceEnergyPerTick = 1
		protectNamed = true
		protectTamed = true
		protectBosses = true
		#Make Mekanism's MekaSuit magnetic attraction respect demagnetization fields
		mekanismIntegration = true
		#Destroy non-player projectiles before they cross a Containment field boundary
		containProjectiles = true
		#Contain projectiles with no owner, including modded projectiles that do not expose one
		containOwnerlessProjectiles = true
		#Prevent explosions from contained projectiles from affecting blocks and entities outside the field
		containProjectileExplosions = true

	#Factory Packer Settings
	[jdte.factoryPacker]
		# Default: 10000000
		# Range: > 1000
		energyCapacity = 10000000
		#Base X/Y/Z radius of the Factory Packer; Range Upgrades multiply it by powers of two
		# Default: 10.0
		# Range: 1.0 ~ 64.0
		baseRadius = 10.0
		#FE consumed for every non-air block captured
		# Default: 100
		# Range: 0 ~ 1000000
		energyPerBlock = 100
		#Maximum capture, cut, placement, or update operations per server tick; Overclock and Creative use four times this budget
		# Default: 512
		# Range: 1 ~ 8192
		blocksPerTick = 512
		#Number of bounded recapture attempts when the source topology changes during packing
		# Default: 3
		# Range: 0 ~ 16
		sourceChangeRetries = 3
		#Hard per-axis safety limit; legacy values below 65 are corrected to the new default
		# Default: 128
		# Range: 65 ~ 256
		maxAxis = 128
		#Hard selected-volume safety limit; legacy values below 65536 are corrected to the new default
		# Default: 1000000
		# Range: 65536 ~ 16777216
		maxVolume = 1000000
		# Default: 33554432
		# Range: > 1048576
		maxCompressedBytes = 33554432
		# Default: 268435456
		# Range: > 1048576
		maxUncompressedBytes = 268435456
		#Maximum block positions sent to one client for a held package structure preview
		# Default: 2048
		# Range: 0 ~ 16384
		previewMaxBlocks = 2048
		#Maximum root entities, including their passenger trees, stored in one package
		# Default: 4096
		# Range: 0 ~ 65536
		maxEntities = 4096
		# Default: 100
		# Range: 0 ~ 1000000
		energyPerEntity = 100
		moveEntities = true
		moveScheduledTicks = true
		#Relocate recognized absolute block positions that point inside the packed area
		remapInternalLinks = true
		#Use public mod move strategies, including AE2 block entity move hooks, when available
		useModMoveStrategies = true
		#Send operation phases, retries, detailed source changes, and results to the initiating player's chat
		chatNotifications = true

	#Advanced Potion Brewer Settings
	[jdte.advancedPotionBrewer]
		#Reject Blaze Powder insertion into the fuel slot from adjacent AE2 crafting providers
		rejectPatternProviderFuelInput = true
		#FE charged per blaze-powder-equivalent fuel charge (20 brews) when the Energy Brewing Upgrade is installed; 0 makes the energy fuel free
		# Default: 5000
		# Range: 0 ~ 1000000
		energyPerBlazePowder = 5000

	#Crystal Incubator Settings
	[jdte.crystalIncubator]
		# Default: 8000
		# Range: 100 ~ 1000000
		fluidCapacity = 8000
		# Default: 10000000
		# Range: > 1000
		energyCapacity = 10000000
		#Multiplier applied to JDT Time Wand-equivalent FE usage
		# Default: 1.0
		# Range: 0.0 ~ 1000.0
		energyCostMultiplier = 1.0
		# Default: 512
		# Range: 1 ~ 65536
		maxMultiplier = 512
		# Default: 1024
		# Range: 1 ~ 65536
		overclockMultiplier = 1024
		#Multiplier applied to JDT Time Wand-equivalent fluid usage
		# Default: 1.0
		# Range: 0.0 ~ 1000.0
		fluidCostMultiplier = 1.0
		#Equivalent AE2 Growth Accelerators used for ordinary budding blocks at 8x; each calls randomTick once every 10 ticks
		# Default: 6.0
		# Range: 0.01 ~ 1024.0
		regularGrowthAcceleratorsAt8x = 6.0
		# Default: 4096
		# Range: 16 ~ 1048576
		scanBatchSize = 4096
		# Default: 200
		# Range: 20 ~ 72000
		cacheRefreshInterval = 200
		# Default: 64
		# Range: 1 ~ 4096
		motherBatchSize = 64
		# Default: 256
		# Range: 1 ~ 65536
		growthOperationsPerTick = 256
		# Default: 64
		# Range: 1 ~ 4096
		harvestOperationsPerTick = 64
		# Default: 128
		# Range: 1 ~ 4096
		dynaGrowthAttempts = 128

	#Greenhouse Settings
	[jdte.greenhouse]
		# Default: 64000
		# Range: > 1000
		fluidCapacity = 64000
		# Default: 10000000
		# Range: > 1000
		energyCapacity = 10000000
		# Default: 512
		# Range: 1 ~ 65536
		baseMultiplier = 512
		# Default: 1
		# Range: 1 ~ 64
		defaultSpeedMultiplier = 1
		# Default: 32
		# Range: 1 ~ 64
		maxSpeedMultiplier = 32
		# Default: 64
		# Range: 1 ~ 256
		overclockMaxSpeedMultiplier = 64
		# Default: 100
		# Range: 1 ~ 1000000
		fluidCostDivisor = 100
		#Ticks between batched production settlements
		# Default: 20
		# Range: 1 ~ 1200
		settlementInterval = 20
		# Default: 4096
		# Range: > 1
		defaultGrowthWork = 4096
		# Default: 10
		# Range: > 0
		energyPerHarvestV2 = 10
		#Mystical Agriculture Time Fluid cost is this value multiplied by crop tier squared
		# Default: 25
		# Range: 1 ~ 1000000
		mysticalBaseFluidCost = 25
		# Default: 10
		# Range: 1 ~ 1000000
		genericFluidCost = 10
		# Default: 4096
		# Range: 1 ~ 65536
		maxHarvestsPerSettlementV2 = 4096
		#Maximum stored work debt per greenhouse planting slot
		# Default: 67108864
		# Range: 1 ~ 9223372036854775807
		maxPendingWork = 67108864
		#Maximum items one Greenhouse may push into one adjacent item handler per real server tick
		# Default: 65536
		# Range: 1 ~ 1048576
		eventOutputItemBudget = 65536
		#Maximum distinct item types one Greenhouse may offer to one adjacent item handler per real server tick
		# Default: 16
		# Range: 1 ~ 64
		eventOutputTypeBudget = 16
		#Maximum exact dynamic harvest-provider calls shared by one Greenhouse per real server tick
		# Default: 128
		# Range: 1 ~ 4096
		dynamicHarvestCallsPerTick = 128
		#When disabled, dynamic Greenhouse and Large Greenhouse JEI recipes are not generated; data-pack recipes remain available.
		recipeGenerationEnabled = true

	#Life Synthesis Vat Settings
	[jdte.lifeSynthesisVat]
		# Default: 20000000
		# Range: > 1000
		energyCapacity = 20000000
		# Default: 64000
		# Range: > 1000
		fluidCapacity = 64000
		#Culture work accumulated per elapsed tick per speed multiplier
		# Default: 1
		# Range: 1 ~ 4096
		baseWorkRate = 1
		# Default: 1
		# Range: 1 ~ 64
		defaultSpeedMultiplier = 1
		# Default: 32
		# Range: 1 ~ 64
		maxSpeedMultiplier = 32
		# Default: 64
		# Range: 1 ~ 256
		overclockMaxSpeedMultiplier = 64
		#Ticks between batched production settlements
		# Default: 20
		# Range: 1 ~ 1200
		settlementInterval = 20
		#Time Fluid drained per completed batch while boosted (0 disables the boost)
		# Default: 100
		# Range: 0 ~ 1000000
		timeFluidPerBatch = 100
		#Maximum pending (undistilled) Life Fluid backlog in millibuckets
		# Default: 262144
		# Range: > 0
		pendingLifeFluidCap = 262144
		#Maximum completed batches processed per settlement
		# Default: 1024
		# Range: 1 ~ 65536
		maxBatchesPerSettlement = 1024

	#Bio Factory Settings
	[jdte.bioFactory]
		# Default: 64000
		# Range: > 1000
		fluidCapacity = 64000
		# Default: 10000000
		# Range: > 1000
		energyCapacity = 10000000
		# Default: 1000
		# Range: > 0
		energyPerCycle = 1000
		# Default: 600
		# Range: 1 ~ 72000
		baseProcessTicks = 600
		#Ticks between lightweight production settlements
		# Default: 20
		# Range: 1 ~ 1200
		settlementInterval = 20
		# Default: 10
		# Range: > 0
		timeFluidPerCycle = 10
		# Default: 32
		# Range: 1 ~ 64
		maxSpeedMultiplier = 32
		# Default: 1
		# Range: 1 ~ 64
		defaultSpeedMultiplier = 1
		# Default: 64
		# Range: 1 ~ 128
		overclockMaxSpeedMultiplier = 64
		# Default: 100
		# Range: > 0
		lifeFluidPerCycle = 100
		# Default: 2.0
		# Range: 1.0 ~ 64.0
		lifeYieldMultiplier = 2.0
		#Minimum flowering fluid required for Productive Bees; the fluid is a reusable catalyst and is not consumed
		# Default: 100
		# Range: > 0
		processFluidPerCycle = 100
		# Default: 10
		# Range: 1 ~ 1000
		externalTimeFluidCostMultiplier = 10
		# Default: 5
		# Range: 1 ~ 1000
		externalLifeFluidCostMultiplier = 5
		#When disabled, dynamic Bio Factory JEI recipes are not generated; data-pack recipes remain available.
		recipeGenerationEnabled = true

	#Life Breeder Settings
	[jdte.lifeBreeder]
		# Default: 10000000
		# Range: > 1000
		energyCapacity = 10000000
		# Default: 64000
		# Range: > 1000
		fluidCapacity = 64000
		# Default: 1000
		# Range: > 0
		breedEnergyCost = 1000
		# Default: 100
		# Range: > 0
		breedFluidCost = 100
		#FE consumed per biological age or breeding-cooldown tick skipped
		# Default: 1
		# Range: 0 ~ 1000000
		energyPerGrowthTick = 1
		#Biological age or cooldown ticks skipped per mB of Life Fluid
		# Default: 20
		# Range: 1 ~ 1000000
		growthTicksPerMb = 20
		#Multiplier applied after converting biological time into Life Fluid
		# Default: 10
		# Range: 1 ~ 1000000
		fluidCostMultiplierV3 = 10
		#Biological time used to price one completed breeding operation; vanilla animals and villagers use 6000 ticks
		# Default: 6000
		# Range: 1 ~ 72000
		breedingCooldownTicks = 6000
		#Ticks between bounded area processing cycles
		# Default: 20
		# Range: 1 ~ 1200
		processingInterval = 20
		# Default: 256
		# Range: 1 ~ 4096
		maxEntitiesInspected = 256
		# Default: 16
		# Range: 1 ~ 1024
		maxPairsPerCycle = 16
		# Default: 128
		# Range: 1 ~ 4096
		maxAnimalsGrownPerCycle = 128
		#Pause breeding a type at this population; set to 0 to disable the density guard
		# Default: 64
		# Range: 0 ~ 4096
		maxAnimalsPerType = 64
		# Default: 128
		# Range: 0 ~ 4096
		maxDropsCollectedPerCycle = 128
		# Default: 1
		# Range: 1 ~ 32
		defaultSpeedMultiplier = 1
		# Default: 32
		# Range: 1 ~ 256
		maxSpeedMultiplier = 32

	#Gel Generator Settings
	[jdte.gelGenerator]
		#Number of input slots
		# Default: 4
		# Range: 1 ~ 27
		gelGeneratorInputSlots = 4
		#Number of output slots
		# Default: 4
		# Range: 1 ~ 27
		gelGeneratorOutputSlots = 4
		#Base fluid capacity (mB)
		# Default: 4000
		# Range: 100 ~ 1000000
		gelGeneratorFluidCapacity = 4000
		#Base energy capacity
		# Default: 100000
		# Range: 1000 ~ 10000000
		gelGeneratorEnergyCapacity = 100000
		#Fluid conversion amount per operation (mB)
		# Default: 1000
		# Range: 1 ~ 100000
		gelGeneratorFluidConversionAmount = 1000
		#Number of uses per food item
		# Default: 2
		# Range: 1 ~ 100
		gelGeneratorFuelUsesPerItem = 2
		#Base energy cost per conversion
		# Default: 1000
		# Range: 10 ~ 100000
		gelGeneratorEnergyCost = 1000

	#Generator Upgrade Settings
	[jdte.generatorUpgrade]
		#Generator upgrade energy output multiplier
		# Default: 3
		# Range: 1 ~ 10
		generatorUpgradeEnergyMultiplier = 3
		#Generator upgrade fluid cost per tick (mB)
		# Default: 2
		# Range: 1 ~ 100
		generatorUpgradeFluidCost = 2

	#Upgrade Item Settings
	[jdte.upgradeItems]
		#Max sharpness upgrades stackable
		# Default: 6
		# Range: 1 ~ 64
		maxSharpnessUpgrades = 6
		#Damage added per sharpness upgrade
		# Default: 5
		# Range: 1 ~ 100
		sharpnessDamagePerUpgrade = 5
		#Max looting upgrades stackable
		# Default: 6
		# Range: 1 ~ 64
		maxLootingUpgrades = 6

	#Time Freezer Settings
	[jdte.timeFreezer]
		# Default: 8000
		# Range: 100 ~ 1000000
		fluidCapacity = 8000
		#Time Fluid consumed per tick while the Time Freezer freezes time and weather
		# Default: 100
		# Range: 1 ~ 100000
		fluidPerTick = 100
		# Default: 200000
		# Range: > 1000
		energyCapacity = 200000
		#FE consumed per tick while the Time Freezer freezes time and weather
		# Default: 100
		# Range: 1 ~ 100000
		energyPerTick = 100

	#Ultimate Portal Gun Settings
	[jdte.ultimatePortalGun]
		#Time Fluid capacity in mB (1000 B default)
		# Default: 1000000
		# Range: 1000 ~ 100000000
		fluidCapacity = 1000000
		# Default: 1000000
		# Range: > 1000
		energyCapacity = 1000000
		#FE consumed per teleport
		# Default: 100
		# Range: 1 ~ 100000
		energyCost = 100
		#Dimensions excluded from the teleport dimension picker, using resource location ids (e.g. "minecraft:the_end")
		teleportDimensionBlacklist = []

	#Mineral Extractor Settings
	[jdte.mineralExtractor]
		# Default: 2000000
		# Range: > 1
		energyCapacity = 2000000
		# Default: 64000
		# Range: > 1
		fluidCapacity = 64000
		# Default: 5000
		# Range: > 0
		energyPerCycle = 5000
		# Default: 25
		# Range: > 0
		experienceFluidPerCycle = 25
		# Default: 5
		# Range: > 0
		timeFluidPerAcceleratedCycle = 5
		# Default: 100
		# Range: 0 ~ 10000
		fortuneBonusPercent = 100
		# Default: 20
		# Range: 1 ~ 72000
		processTicks = 20
		# Default: 20
		# Range: 1 ~ 1200
		settlementInterval = 20
		# Default: 1
		# Range: 1 ~ 1024
		defaultMultiplier = 1
		# Default: 32
		# Range: 1 ~ 32
		maxMultiplier = 32
		# Default: 64
		# Range: 1 ~ 64
		overclockMaxMultiplier = 64
		# Default: 65536
		# Range: 1 ~ 10000000
		maxCyclesPerSettlement = 65536
		# Default: 20000000
		# Range: 1 ~ 9223372036854775807
		maxPendingWork = 20000000

	#Advanced Energy Transmitter Settings
	[jdte.advancedEnergyTransmitter]
		#Internal energy buffer size in FE
		# Default: 2000000000
		# Range: > 1000
		energyCapacity = 2000000000
		#Base tick interval between transmit operations
		# Default: 1
		# Range: 1 ~ 100
		baseTickDelay = 1
		#Ticks between refreshing the target block cache
		# Default: 20
		# Range: 1 ~ 1200
		targetRefreshInterval = 20
		#Maximum block positions inspected per server tick while rebuilding the target cache
		# Default: 512
		# Range: 1 ~ 100000
		scanBlocksPerTick = 512
		#Maximum cached targets attempted per transmit operation, including full or invalid targets
		# Default: 512
		# Range: 1 ~ 100000
		maxTargetsPerTick = 512
		#Maximum FE sent to one target per operation; 0 removes the per-target cap
		# Default: 0
		# Range: > 0
		maxTransferPerTarget = 0
		#Maximum total FE delivered per operation before overclock scaling
		# Default: 268435456
		# Range: > 1
		transferBudgetPerTick = 268435456
		#Transfer and ME extraction budget multiplier while overclocked
		# Default: 8
		# Range: 1 ~ 64
		overclockTransferMultiplier = 8
		#Maximum FE pulled from Applied Flux ME storage per operation before overclock scaling; 0 disables ME extraction
		# Default: 268435456
		# Range: > 0
		meExtractionLimitPerTick = 268435456
		#Exclude other Advanced Energy Transmitters from targets to prevent energy loops
		excludeTransmitters = true
		#Whether newly placed transmitters show particles by default
		showParticlesByDefault = false
		#Maximum successful targets that emit one transfer particle per operation
		# Default: 8
		# Range: 0 ~ 128
		maxParticleTargetsPerTick = 8
		#Maximum equipped player items inspected per operation; hard-capped at 64 and separate from block target budgets
		# Default: 64
		# Range: 1 ~ 64
		playerChargeMaxItemsPerTick = 64
		#Maximum receiveEnergy calls per equipped item per operation for items with per-call limits; hard-capped at 16
		# Default: 16
		# Range: 1 ~ 16
		playerChargeMaxCallsPerItem = 16

	#Infusion Machine Settings
	[jdte.infusion]
		#Mod ids (resource namespaces) whose spawn eggs are excluded from the Infusion Machine's dynamic spawn egg recipes, e.g. "occultism". As a result no infusion recipe is generated for those spawn eggs and they can no longer be produced from mob loot. Full item or entity resource location ids (e.g. "occultism:debug_familiar_spawn_egg") are also accepted.
		spawnEggModBlacklist = ["occultism"]

	#Repair Talisman Settings
	[jdte.repairTalisman]
		#Durability points repaired per cycle for every damaged item while a Repair Talisman is in the inventory
		# Default: 5
		# Range: 1 ~ 1000
		amountPerCycle = 5
		#Ticks between repair cycles; 0 disables the talisman
		# Default: 4
		# Range: 0 ~ 1200
		cycleInterval = 4
		#FE consumed per durability point repaired, drawn from charged energy items in the player's inventory; 0 makes repairs free
		# Default: 10000
		# Range: 0 ~ 100000000
		energyPerDurability = 10000

	#AE Output Upgrade Settings
	[jdte.aeOutput]
		#Ticks between AE return flushes on machines with the AE Output Upgrade installed
		# Default: 5
		# Range: 1 ~ 1200
		returnInterval = 5

	#Content Settings
	[jdte.content]
		#Block ids or directory prefixes to disable. Missing namespaces default to jdte, so greenhouse means jdte:greenhouse.
		disabledBlocks = []
		#Recipe ids or directory prefixes to disable. Missing namespaces default to jdte, so greenhouse means jdte:greenhouse.
		disabledRecipes = []
		#When disabled, all Time Accelerator blocks and their bundled crafting recipes remain registered but cannot be used.
		timeAcceleratorEnabled = true
		#When disabled, all Time Freezer blocks and their bundled crafting recipes remain registered but cannot be used.
		timeFreezerEnabled = true
