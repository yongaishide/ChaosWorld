[General]
	#Enable custom extraction frequency for Item Pipes (1-200 ticks).
	enableItemCustomFrequency = true
	#Enable custom extraction frequency for Fluid Pipes (1-200 ticks).
	enableFluidCustomFrequency = true
	#Enable custom extraction frequency for Energy Pipes (1-200 ticks).
	enableEnergyCustomFrequency = true
	#Enable custom extraction frequency for Gas Pipes (1-200 ticks).
	enableGasCustomFrequency = true

[Optimization]
	#Max sleep ticks for Item Pipes when empty/full.
	# Default: 40
	# Range: 1 ~ 1200
	itemMaxSleep = 40
	#Max sleep ticks for Fluid Pipes when empty/full.
	# Default: 40
	# Range: 1 ~ 1200
	fluidMaxSleep = 40
	#Max sleep ticks for Energy Pipes when empty/full. (Keep low to prevent power loss)
	# Default: 5
	# Range: 1 ~ 1200
	energyMaxSleep = 5
	#Max sleep ticks for Gas Pipes when empty/full.
	# Default: 40
	# Range: 1 ~ 1200
	gasMaxSleep = 40

	[Upgrades.Item]
		#Transfer rate for ATM Upgrade
		# Default: 4096
		# Range: > 1
		itemRateAtm = 4096
		#Transfer rate for Vibranium Upgrade
		# Default: 65536
		# Range: > 1
		itemRateVibranium = 65536
		#Transfer rate for Unobtainium Upgrade
		# Default: 1048576
		# Range: > 1
		itemRateUnobtainium = 1048576
		#Transfer rate for Stellar Upgrade
		# Default: 16777216
		# Range: > 1
		itemRateStellar = 16777216

	[Upgrades.Fluid]
		#Transfer rate for ATM Upgrade
		# Default: 1000000
		# Range: > 1
		fluidRateAtm = 1000000
		#Transfer rate for Vibranium Upgrade
		# Default: 16000000
		# Range: > 1
		fluidRateVibranium = 16000000
		#Transfer rate for Unobtainium Upgrade
		# Default: 256000000
		# Range: > 1
		fluidRateUnobtainium = 256000000
		#Transfer rate for Stellar Upgrade
		# Default: 1000000000
		# Range: > 1
		fluidRateStellar = 1000000000

	[Upgrades.Energy]
		#Transfer rate for ATM Upgrade
		# Default: 10000000
		# Range: > 1
		energyRateAtm = 10000000
		#Transfer rate for Vibranium Upgrade
		# Default: 100000000
		# Range: > 1
		energyRateVibranium = 100000000
		#Transfer rate for Unobtainium Upgrade
		# Default: 500000000
		# Range: > 1
		energyRateUnobtainium = 500000000
		#Transfer rate for Stellar Upgrade
		# Default: 1500000000
		# Range: > 1
		energyRateStellar = 1500000000

	[Upgrades.Gas]
		#Transfer rate for ATM Upgrade
		# Default: 4000000
		# Range: > 1
		gasRateAtm = 4000000
		#Transfer rate for Vibranium Upgrade
		# Default: 64000000
		# Range: > 1
		gasRateVibranium = 64000000
		#Transfer rate for Unobtainium Upgrade
		# Default: 512000000
		# Range: > 1
		gasRateUnobtainium = 512000000
		#Transfer rate for Stellar Upgrade
		# Default: 1500000000
		# Range: > 1
		gasRateStellar = 1500000000
