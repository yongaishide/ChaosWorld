[UpgradeLimits]
	#机器插件安装数量上限规则（服务端）
	#用于限制"装 1 个即完整生效"的布尔型升级，避免浪费。
	#每行是一个 JSON 对象：
	#  {
	#    "item"    : 物品注册id，必填。支持 "#物品标签"
	#    "machine" : 机器方块注册id，必填。支持 "#方块标签"；"*" = 所有 ProductiveLib 机器
	#    "max"     : 最多可装数量，必填。0 = 禁止安装该升级
	#  }
	#请用单引号 '' 包裹 JSON，避免内部引号转义。
	#内置默认规则已覆盖 资源蜜蜂 / 资源蜜蜂：创世 的布尔型升级；第三方布尔型升级请自行追加。
	#
	#怎么用：
	#1. 编辑 [UpgradeLimits] 下的 rules，保存后重启游戏（或重载配置）生效。
	#2. 物品/方块 id：游戏中按 F3+H 打开高级提示，悬停物品/方块即可看到注册id；
	#   标签在 data/<模组>/tags/(item|block)/ 下可查。
	#3. 示例：
	#   '{"item":"mymod:my_boolean_upgrade","machine":"mymod:my_machine","max":1}'
	#   '{"item":"mymod:my_boolean_upgrade","machine":"*","max":1}'
	#   '{"item":"#mymod:boolean_upgrades","machine":"mymod:my_machine","max":1}'
	rules = ["{\"item\":\"productivelib:upgrade_simulator\",\"machine\":\"*\",\"max\":1}", "{\"item\":\"productivelib:upgrade_block\",\"machine\":\"*\",\"max\":1}", "{\"item\":\"productivelib:upgrade_anti_teleport\",\"machine\":\"*\",\"max\":1}", "{\"item\":\"productivelib:upgrade_entity_filter\",\"machine\":\"*\",\"max\":1}", "{\"item\":\"productivelib:upgrade_child\",\"machine\":\"productivebees:catcher\",\"max\":1}", "{\"item\":\"productivelib:upgrade_adult\",\"machine\":\"productivebees:catcher\",\"max\":1}"]
