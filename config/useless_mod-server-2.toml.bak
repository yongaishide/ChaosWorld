[omniversal_multiblock_alloy_furnace]
	#ME pattern assembly slots. Values are normalized to pages of 27.
	# Default: 108
	# Range: 27 ~ 540
	pattern_slots = 108
	#Omniversal mold hub slots. Values are normalized to pages of 27.
	# Default: 108
	# Range: 27 ~ 540
	mold_slots = 108
	#Passive crafting hatch slots. Higher coil tiers unlock this capacity gradually.
	# Default: 30
	# Range: 1 ~ 540
	passive_pattern_slots = 30
	#Maximum decoded omniversal pattern entries kept per level. Takes effect after restart.
	# Default: 2048
	# Range: 64 ~ 16384
	decode_cache_capacity = 2048

[ore_generator]
	#Ore generator sample slots. Slots above this value remain recovery-only.
	# Default: 9
	# Range: 1 ~ 540
	ore_generator_slots = 9

[useless_dimension]
	#Blocks that cannot be used for Useless Dimension borders, fills, or centers
	#A block matching this list remains blocked even if it matches the whitelist
	#Use exact block IDs, #block tags, or * wildcard patterns
	floor_block_blacklist = []
	#When non-empty, only matching blocks can be used for Useless Dimension borders, fills, or centers
	#Leave empty to allow every block that is not on the blacklist
	#Use exact block IDs, #block tags, or * wildcard patterns
	floor_block_whitelist = ["useless_mod:black_plastic", "useless_mod:red_plastic", "useless_mod:green_plastic", "useless_mod:brown_plastic", "useless_mod:blue_plastic", "useless_mod:purple_plastic", "useless_mod:cyan_plastic", "useless_mod:light_gray_plastic", "useless_mod:gray_plastic", "useless_mod:pink_plastic", "useless_mod:lime_plastic", "useless_mod:yellow_plastic", "useless_mod:light_blue_plastic", "useless_mod:magenta_plastic", "useless_mod:orange_plastic", "useless_mod:white_plastic", "useless_mod:dark_red_plastic", "useless_mod:aqua_plastic", "useless_mod:black_glow_plastic", "useless_mod:red_glow_plastic", "useless_mod:green_glow_plastic", "useless_mod:brown_glow_plastic", "useless_mod:blue_glow_plastic", "useless_mod:purple_glow_plastic", "useless_mod:cyan_glow_plastic", "useless_mod:light_gray_glow_plastic", "useless_mod:gray_glow_plastic", "useless_mod:pink_glow_plastic", "useless_mod:lime_glow_plastic", "useless_mod:yellow_glow_plastic", "useless_mod:light_blue_glow_plastic", "useless_mod:magenta_glow_plastic", "useless_mod:orange_glow_plastic", "useless_mod:white_glow_plastic", "useless_mod:dark_red_glow_plastic", "useless_mod:aqua_glow_plastic", "minecraft:white_concrete", "minecraft:light_gray_concrete", "minecraft:gray_concrete", "minecraft:black_concrete", "minecraft:brown_concrete", "minecraft:red_concrete", "minecraft:orange_concrete", "minecraft:yellow_concrete", "minecraft:lime_concrete", "minecraft:green_concrete", "minecraft:cyan_concrete", "minecraft:light_blue_concrete", "minecraft:blue_concrete", "minecraft:purple_concrete", "minecraft:magenta_concrete", "minecraft:pink_concrete"]

[game_mechanics]
	#植物盆生长倍率 - 1.0为原版速度, 2.0为2倍速度
	# Default: 1
	# Range: > 1
	botany_pot_growth_multiplier = 1
	#矩阵样板槽位倍数 - 减少数量时请保持槽位空！否则可能会造成样板丢失
	# Default: 1
	# Range: 1 ~ 100
	matrix_pattern_count = 1

[ae2_gift_package]
	#Items granted by the AE2 gift package. Format: modid:item_id,count.
	#Missing items and entries with invalid quantities are skipped.
	items = ["ae2:creative_energy_cell,1", "ae2:fluix_covered_cable,64", "ae2:wireless_access_point,1", "ae2:wireless_booster,64", "ae2:wireless_crafting_terminal,1", "ae2:crafting_terminal,1", "extendedae_plus:infinity_biginteger_cell,1", "extendedae:ex_drive,1", "ae2wtlib:quantum_bridge_card,1", "ae2:quantum_ring,8", "ae2:quantum_link,1", "ae2:quantum_entangled_singularity,2"]

[beef_tool]
	#Custom potion effects. Format: modid:effect_id,amplifier.
	#Use one effect per list entry. Missing effects and invalid levels are skipped.
	custom_potion_effects = ["minecraft:saturation,1", "minecraft:regeneration,6", "minecraft:night_vision,1", "minecraft:fire_resistance,1", "minecraft:water_breathing,1", "minecraft:resistance,6"]
	#是否启用药水效果
	enable_potion_effects = true
	#是否启用飞行效果
	enable_flight_effect = true
	#牛排工具飞行速度
	# Default: 0.05
	# Range: 0.01 ~ 1.0
	beef_tool_flight_speed = 0.05
	#连锁挖掘的X轴范围半径
	# Default: 8
	# Range: 1 ~ 32
	chain_mining_range_x = 8
	#连锁挖掘的Y轴范围半径
	# Default: 8
	# Range: 1 ~ 255
	chain_mining_range_y = 8
	#连锁挖掘的Z轴范围半径
	# Default: 8
	# Range: 1 ~ 32
	chain_mining_range_z = 8
	#连锁挖掘的最大方块数量
	# Default: 1000
	# Range: 1 ~ 1000000
	chain_mining_max_blocks = 1000
	#牛排工具时运附魔等级
	# Default: 10
	# Range: 1 ~ 127
	fortune_level = 10
	#牛排工具抢夺附魔等级
	# Default: 10
	# Range: 1 ~ 127
	looting_level = 10
	#战利品大爆发触发概率 (百分比, 1-100%)
	# Default: 5
	# Range: 1 ~ 100
	festive_drop_chance = 5
	#牛排工具基础挖掘速度
	# Default: 10.0
	# Range: 1.0 ~ 1000.0
	beef_tool_mining_speed = 10.0
	#牛排工具实体触及范围加成, 重启游戏生效
	# Default: 8.0
	# Range: 0.0 ~ 1024.0
	beef_tool_entity_interaction_range = 8.0
	#牛排工具方块触及范围加成, 重启游戏生效
	# Default: 8.0
	# Range: 0.0 ~ 1024.0
	beef_tool_block_interaction_range = 8.0
	#牛排工具强制挖掘黑名单，不会被强制挖掘的方块
	#支持精确方块ID、#方块标签和*通配符
	beef_tool_force_mining_blacklist = []
	#牛排工具强制击杀黑名单, 多个实体ID用分号分隔, 例如 minecraft:wither;modid:boss
	beef_tool_force_kill_blacklist = ""
	#牛排工具非生物实体强制击杀白名单, 多个实体ID用分号分隔
	beef_tool_force_kill_non_living_whitelist = "draconicevolution:guardian_crystal"

[mekanism_upgrade]
	#速度升级增强倍率
	# Default: 1
	# Range: > 1
	time_multiplier = 1
	#能量升级节电增强倍率
	# Default: 1
	# Range: > 1
	electricity_multiplier = 1
	#能量升级储电增强倍率
	# Default: 1
	# Range: > 1
	capacity_multiplier = 1
	#机器可接受的最大速度/能量升级数量, 重启游戏生效
	# Default: 16
	# Range: 1 ~ 64
	max_upgrade = 16

[advanced_alloy_furnace]
	#万象炉是否自动从所在AE网络抽取AppliedFlux(应用通量)存储的FE能量
	#需要安装AppliedFlux且网络中有通量元件, 每tick抽取量受熔炉最大输入速率限制
	draw_appflux_energy = true
	#万象炉是否直接抽取AE网络自身的能量(按 1 AE = 2 FE 折算)
	#警告: 会与网络中其他设备争抢供电, 网络储能不足时可能导致设备频繁掉线
	#在AppliedFlux抽取之后作为补充, 每tick总抽取量受熔炉最大输入速率限制
	draw_ae_energy = false
