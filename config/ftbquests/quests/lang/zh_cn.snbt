	quest.44B1D89C5D74BE65.title: "整合包介绍"
	quest.487A2FD75215DAC3.quest_desc: ["能量耗尽会直接消失，使用时请注意能量消耗"]
	quest.49D62DB9E3263F9D.quest_desc: ["通量能源端口允许你通过通量网络直接访问龙球的存储系统，而无需使用传统的能量塔进行繁琐的中转操作"]
	quest.4A9E813977CAC5E2.quest_subtitle: "领了默认你是猪咪"
	quest.4F2F703E5B15578C.quest_desc: [
		"装配线的使用非常简单，不要把他想的太过复杂"
		"首先需要准备一个&6装配平台&r，在他的旁边放上&6装配钻头、装配激光、装配台交互设备(&a输入&r)(&9输出&r)&r，再把&6装配台&r放在旁边就行。"
		"其中&6装配台交互设备(&a输入&r)(&9输出&r)&r会自动识别周围的箱子，然后从里面拿出原料和放入产物"
	]
	quest.4F2F703E5B15578C.quest_subtitle: "装配线"
	quest.5363061E91654005.quest_desc: [
		"目前只用于无线充能。"
		""
		"打开它的GUI，点开上方最后的标签可以设置网络的名称，网络的颜色，是否对外公开。"
		""
		"倒数第二个标签可以添加允许访问该网络的玩家，倒数第三个标签可以修改网络设置，倒数第四个标签可以看到网络传输的具体数据，倒数第五个是网络的连接清单。"
		""
		"每个网络至多存在1个控制器"
		""
		"仅当网络中存在控制器且在无线充能界面中启用才能进行无线充能。"
	]
	quest.55D2B3830627481E.title: "死亡不掉落"
	quest.64F5529172752BFC.quest_subtitle: "大量获取末影珍珠"
	quest.6509D4C15F29CDEE.quest_desc: [
		"压力室，是前期生产芯片材料重要的一环，是一个中空正方体，棱长可选3，4，5。"
		"主体由压力室墙壁或者压力室玻璃组成，这两者可以相互替换，没有任何影响。"
		"至少有一个压力室阀门，压力室接口则是可选择的，不过还是建议安装以方便使用。"
		"不然只能破坏结构进去捡东西了摆放完成后如果材质发生变化或者有粒子效果生成，则标志着压力室构建成功。"
	]
	quest.6509D4C15F29CDEE.title: "压力室"
	quest.683CF00B79A9E0FA.quest_desc: [
		"手持工厂安装器shift右击低一个等级的机器和储罐提升到安装器对应的等级；"
		"本质上是简化机器升级套娃操作的物品。"
		"（但还是要消耗一个木板）"
	]
	quest.683CF00B79A9E0FA.quest_subtitle: "工厂！"
	quest.6C4EB991E2A1D634.quest_desc: ["通量访问端口允许你通过通量网络直接访问AE网络的存储系统"]
