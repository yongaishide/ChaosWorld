	quest.004E10BDB05C90E2.quest_subtitle: "实在找不到可以在商店买"
	quest.1E759BD8CC5BEAB1.quest_desc: [
		"许多网络元件都需要频道才能运转，如终端、驱动器、ME接口等。"
		""
		"一旦缺少频道，那么这个设备就不工作了。如果没有ME控制器而使用了超过8个频道，则整个网络直接瘫痪，只剩能量交互。"
	]
	quest.1E759BD8CC5BEAB1.quest_subtitle: "选择你的频道数量"
	quest.2AFC51C204AAE490.quest_subtitle: "挖不着紫水晶还想玩AE"
