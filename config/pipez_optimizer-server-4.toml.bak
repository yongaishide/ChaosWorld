[General]
	#是否允许玩家自定义【物品管道】的抽取频率（1~200 tick）。
	enableItemCustomFrequency = true
	#是否允许玩家自定义【流体管道】的抽取频率（1~200 tick）。
	enableFluidCustomFrequency = true
	#是否允许玩家自定义【能量管道】的抽取频率（1~200 tick）。
	enableEnergyCustomFrequency = true
	#是否允许玩家自定义【气体管道】的抽取频率（1~200 tick）。
	enableGasCustomFrequency = true

	[Upgrades.Item]
		#ATM升级的传输速率
		# Default: 128
		# Range: > 1
		itemRateAtm = 128
		#振金升级的传输速率
		# Default: 256
		# Range: > 1
		itemRateVibranium = 256
		#难得素升级的传输速率
		# Default: 1024
		# Range: > 1
		itemRateUnobtainium = 1024

	[Upgrades.Fluid]
		#ATM升级的传输速率
		# Default: 50000
		# Range: > 1
		fluidRateAtm = 50000
		#振金升级的传输速率
		# Default: 250000
		# Range: > 1
		fluidRateVibranium = 250000
		#难得素升级的传输速率
		# Default: 1000000
		# Range: > 1
		fluidRateUnobtainium = 1000000

	[Upgrades.Energy]
		#ATM升级的传输速率
		# Default: 500000
		# Range: > 1
		energyRateAtm = 500000
		#振金升级的传输速率
		# Default: 2500000
		# Range: > 1
		energyRateVibranium = 2500000
		#难得素升级的传输速率
		# Default: 10000000
		# Range: > 1
		energyRateUnobtainium = 10000000

	[Upgrades.Gas]
		#ATM升级的传输速率
		# Default: 200000
		# Range: > 1
		gasRateAtm = 200000
		#振金升级的传输速率
		# Default: 1000000
		# Range: > 1
		gasRateVibranium = 1000000
		#难得素升级的传输速率
		# Default: 4000000
		# Range: > 1
		gasRateUnobtainium = 4000000
