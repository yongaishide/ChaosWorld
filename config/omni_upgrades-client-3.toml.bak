[BatchInstall]
	#Sequential Fill Mode (default: OFF).
	#ON : Fill one machine completely before moving on to the next one.
	#OFF: Evenly distribute upgrades across all machines.
	#Toggled in game with Shift+N.
	sequentialFillMode = false
	#Diagonal Detection Mode (default: OFF).
	#ON : Batch detection spreads to diagonal neighbors as well (square-shaped scan).
	#OFF: Only directly adjacent neighbors are checked.
	#Toggled in game with Shift+M.
	diagonalDetectionMode = false

[General]
	#Master Switch (default: ON).
	#Turn OFF to fully disable Omni Upgrades: batch install, highlights and right-click
	#interception are all skipped, giving control back to vanilla/other mods.
	#Toggled in game with Shift+O; also editable in this file.
	enabled = true

[Blacklist]
	#Item Blacklist (Client-side, per-player).
	#Items listed here are never treated as upgrade items by Omni Upgrades:
	#right-click interception and highlights are skipped for them, letting the
	#original mod / vanilla game handle them normally.
	#Useful for AE2-family cards that are NOT installable machine upgrades but are
	#still recognized through the upgrade-card API (e.g. AE2 Lightning Tech's
	#Overloaded Frequency Card 'ae2lt:overloaded_frequency_card').
	#Each entry is an item registry id. Prefix '#' to block a whole item tag
	#(e.g. '#ae2:upgrade_cards').
	#The list is synced to the server on login; changes apply after restarting the game.
	blacklist = []
